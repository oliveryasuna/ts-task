{
  "name": "ts-task",
  "version": "1.0.0",
  "license": "MIT",
  "description": "A minimal task runner.",
  "homepage": "https://github.com/oliveryasuna/ts-task",
  "author": "Oliver Yasuna",
  "repository": {
    "type": "git",
    "url": "https://github.com/oliveryasuna/ts-task.git"
  },
  "bugs": "https://github.com/oliveryasuna/ts-task/issues",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "tsdown",
    "check:bun": "bun run ./check-bun-version.ts",
    "format:pkg": "syncpack format",
    "lint": "eslint",
    "prepack": "bun run build",
    "prepare": "husky",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@oliveryasuna/eslint-config": "2.1.0",
    "@oliveryasuna/tsdown-config": "1.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.2",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/bun": "1.3.14",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.1.0",
    "secretlint": "13.0.2",
    "syncpack": "15.3.2",
    "tsdown": "0.22.14",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
