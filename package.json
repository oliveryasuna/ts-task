{
  "name": "@oliveryasuna/ts-task",
  "version": "1.0.1",
  "license": "MIT",
  "description": "A task runner configured entirely in TypeScript.",
  "homepage": "https://github.com/oliveryasuna/ts-task",
  "author": "Oliver Yasuna",
  "repository": {
    "type": "git",
    "url": "https://github.com/oliveryasuna/ts-task.git"
  },
  "bugs": "https://github.com/oliveryasuna/ts-task/issues",
  "keywords": [
    "build",
    "task",
    "task-runner",
    "tasks",
    "typescript"
  ],
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.18.0"
  },
  "type": "module",
  "bin": {
    "ts-task": "./dist/cli.js",
    "tstask": "./dist/cli.js",
    "tt": "./dist/cli.js"
  },
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "prepack": "bun ./src/cli.ts build",
    "prepare": "husky"
  },
  "dependencies": {
    "chalk": "6.0.0",
    "chokidar": "5.0.0",
    "commander": "15.0.0",
    "jiti": "2.7.0",
    "p-limit": "7.3.1",
    "safe-stable-stringify": "2.5.0",
    "tinyexec": "1.3.0"
  },
  "devDependencies": {
    "@oliveryasuna/eslint-config": "2.1.0",
    "knip": "6.32.2",
    "@oliveryasuna/tsdown-config": "1.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.2",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/bun": "1.3.14",
    "husky": "9.1.7",
    "lint-staged": "17.1.0",
    "secretlint": "13.0.2",
    "syncpack": "15.3.2",
    "tsdown": "0.22.14",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
